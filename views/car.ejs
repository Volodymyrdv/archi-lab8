<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link
			href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/css/bootstrap.min.css"
			rel="stylesheet"
			integrity="sha384-SgOJa3DmI69IUzQ2PVdRZhwQ+dy64/BUtbMJw1MZ8t5HZApcHrRKUc4W0kG879m7"
			crossorigin="anonymous"
		/>
		<link rel="stylesheet" href="./../public/style/main.css" />
		<title>Автомобілі</title>
	</head>
	<body>
		<div class="container mt-5">
			<h1 class="text-center mb-4">Список Автомобілів</h1>
			<a class="btn btn-outline-secondary mb-3" href="/">Повернутися на головну</a>
			<table class="table table-bordered table-striped">
				<thead class="table-dark">
					<tr>
						<th>ID</th>
						<th>Марка</th>
						<th>Тип</th>
						<th>Модель</th>
						<th>Колір</th>
						<th>Рік Виробництва</th>
						<th>Ціна Оренди (на день)</th>
						<th>Дії</th>
					</tr>
				</thead>
				<tbody>
					<% if (cars && cars.length > 0) { %> <% cars.forEach(function(car) { %> <% if (car.CarType
					&& car.CarModel && car.CarColor && car.YearOfManufacture && car.DailyRentalPrice) { %>
					<tr>
						<td><%= car.ID %></td>
						<td><%= car.MarkName %></td>
						<td><%= car.CarType %></td>
						<td><%= car.CarModel %></td>
						<td><%= car.CarColor %></td>
						<td><%= car.YearOfManufacture %></td>
						<td><%= car.DailyRentalPrice %></td>
						<td>
							<a href="/api/car/<%= car.ID %>" class="btn btn-sm btn-info">Змінити</a>
							<a href="/api/car/delete/<%= car.ID %>" class="btn btn-sm btn-danger">Видалити</a>
						</td>
					</tr>
					<% } %> <% }); %> <% } else { %>
					<tr>
						<td colspan="7" class="text-center">Немає даних</td>
					</tr>
					<% } %>
				</tbody>
			</table>
			<h2 class="text-center">Додати автомобіль</h2>
			<form action="/api/car" method="post" class="text-center">
				<div class="mb-3">
					<label
						>Марка автомобіля
						<select class="form-select" id="IdMark" name="IdMark" required>
							<option value="" disabled selected>Оберіть марку</option>
							<% if (cardirectories && cardirectories.length > 0) { %> <%
							cardirectories.forEach(function(mark) { %>
							<option value="<%= mark.ID %>"><%= mark.MarkName %></option>
							<% }); %> <% } %>
						</select>
					</label>
				</div>
				<div class="mb-3">
					<label>
						Тип автомобіля
						<input
							type="text"
							class="form-control"
							placeholder="Тип автомобіля"
							id="CarType"
							name="CarType"
							required
						/>
					</label>
				</div>
				<div class="mb-3">
					<label>
						Модель автомобіля
						<input
							type="text"
							class="form-control"
							placeholder="Модель автомобіля"
							id="CarModel"
							name="CarModel"
							required
						/>
					</label>
				</div>
				<div class="mb-3">
					<label>
						Колір автомобіля
						<input
							type="text"
							class="form-control"
							placeholder="Колір автомобіля"
							id="CarColor"
							name="CarColor"
							required
						/>
					</label>
				</div>
				<div class="mb-3">
					<label>
						Рік випуску автомобіля
						<input
							type="number"
							min="1990"
							max="2025"
							class="form-control"
							id="YearOfManufacture"
							name="YearOfManufacture"
							required
						/>
					</label>
				</div>
				<div class="mb-3">
					<label>
						Ціна за день автомобіля
						<input
							min="1"
							type="number"
							class="form-control"
							id="DailyRentalPrice"
							name="DailyRentalPrice"
							required
						/>
					</label>
				</div>
				<button type="submit" class="btn btn-primary">Додати</button>
			</form>
		</div>
		<script
			src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/js/bootstrap.bundle.min.js"
			integrity="sha384-k6d4wzSIapyDyv1kpU366/PK5hCdSbCRGRCMv+eplOQJWyd1fbcAu9OCUj5zNLiq"
			crossorigin="anonymous"
		></script>
	</body>
</html>
